<Window x:Class="VaultSentry.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VaultSentry - Secure Download Quarantine &amp; Static Analysis Platform" 
        Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <DockPanel>
                <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                    <TextBlock Text="VAULTSENTRY" FontSize="22" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock Text="Pre-Storage Quarantine &amp; Static Security Inspection" FontSize="12" Foreground="#94A3B8"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#0284C7" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="VQS ACTIVE" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- File Input Dropzone -->
        <Border Grid.Row="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="2" CornerRadius="8" Padding="20" Margin="0,0,0,15"
                AllowDrop="True" Drop="FileDropZone_Drop">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSelectedFile" Text="Drag &amp; Drop Downloaded File Here, or Click Browse" FontSize="14" Foreground="#CBD5E1" FontWeight="Medium"/>
                    <TextBlock x:Name="TxtFilePath" Text="No file staged for scanning." FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Browse File" Click="BtnBrowse_Click" Width="100" Height="36" Background="#334155" Foreground="White" BorderThickness="0" Margin="0,0,10,0"/>
                    <Button x:Name="BtnStartScan" Content="Start Scan" Click="BtnStartScan_Click" Width="110" Height="36" Background="#0EA5E9" Foreground="White" FontWeight="Bold" BorderThickness="0" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area: Scan Results -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Risk Assessment Card -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                <StackPanel x:Name="PnlAssessment" Visibility="Hidden">
                    <TextBlock Text="ASSESSMENT VERDICT" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    
                    <Border x:Name="BdrVerdict" Background="#22C55E" CornerRadius="6" Padding="10" Margin="0,10,0,15">
                        <TextBlock x:Name="TxtVerdict" Text="SAFE" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Risk Score" FontSize="12" Foreground="#94A3B8"/>
                    <ProgressBar x:Name="PbRiskScore" Height="12" Minimum="0" Maximum="100" Value="0" Margin="0,5,0,5" Foreground="#22C55E" Background="#0F172A"/>
                    <TextBlock x:Name="TxtRiskScore" Text="0 / 100" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#F8FAFC"/>

                    <Separator Background="#334155" Margin="0,15"/>

                    <TextBlock Text="Recommendation" FontSize="12" FontWeight="Bold" Foreground="#94A3B8"/>
                    <TextBlock x:Name="TxtRecommendation" Text="-" TextWrapping="Wrap" FontSize="12" Foreground="#CBD5E1" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Right Panel: Detailed Findings -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="20" Margin="10,0,0,0">
                <DockPanel x:Name="PnlFindings" Visibility="Hidden">
                    <TextBlock Text="EXPLAINABLE FINDINGS &amp; DETECTION DETAILS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" DockPanel.Dock="Top" Margin="0,0,0,10"/>
                    <ListView x:Name="LvFindings" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F172A" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Severity}" FontWeight="Bold" Foreground="#EF4444" DockPanel.Dock="Left"/>
                                            <TextBlock Text="{Binding Category}" Foreground="#64748B" FontSize="11" DockPanel.Dock="Right"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="#38BDF8" Margin="0,4,0,2"/>
                                        <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="12" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer Action Controls -->
        <Border Grid.Row="3" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,15,0,0">
            <DockPanel>
                <TextBlock x:Name="TxtStatus" Text="Ready." VerticalAlignment="Center" Foreground="#94A3B8" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button x:Name="BtnDelete" Content="Permanently Delete" Click="BtnDelete_Click" Width="140" Height="36" Background="#DC2626" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" IsEnabled="False"/>
                    <Button x:Name="BtnKeepQuarantine" Content="Keep Quarantined" Click="BtnKeepQuarantine_Click" Width="140" Height="36" Background="#475569" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" IsEnabled="False"/>
                    <Button x:Name="BtnMoveStorage" Content="Move to Local Storage" Click="BtnMoveStorage_Click" Width="160" Height="36" Background="#16A34A" Foreground="White" FontWeight="Bold" BorderThickness="0" IsEnabled="False"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>