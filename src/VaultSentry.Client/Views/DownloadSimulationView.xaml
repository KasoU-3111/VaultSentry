<UserControl x:Class="VaultSentry.Client.Views.DownloadSimulationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:VaultSentry.Client.Converters"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="900">
    <UserControl.Resources>
        <converters:SeverityToBrushConverter x:Key="SeverityToBrushConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,30,34,36">
            <TextBlock Text="VQS URL ingestion" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,7" />
            <TextBlock Text="Fetch an HTTPS file into temporary staging, review its local static analysis report, then choose whether to delete the quarantined copy or authorize its release."
                       Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,22" />

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Diagnostics &amp; calibration" Style="{StaticResource SectionHeadingStyle}" />
                            <TextBlock Text="Run a bundled synthetic sample through the same staging, analysis, and decision workflow without making a network request."
                                       Style="{StaticResource PageSubtitleStyle}" FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Run synthetic sample"
                                Command="{Binding GuidedDemoCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                AutomationProperties.Name="Run synthetic sample"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="16,0,0,0" />
                    </Grid>
                    <Border Background="#102A32" BorderBrush="#0F766E" BorderThickness="1"
                            CornerRadius="6" Padding="10" Margin="0,8,0,14">
                        <TextBlock Text="Synthetic sample: a test payload designed to trigger a file-type mismatch finding. It is submitted for static analysis only; do not open or release it. Staging is not a virtual machine or a guarantee of containment."
                                   Foreground="#99F6E4" FontSize="11" TextWrapping="Wrap" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding GuidedDemoStages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="1" CornerRadius="7" Padding="12"
                                        Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource SurfaceInsetBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Current">
                                                    <Setter Property="Background" Value="#102A32" />
                                                    <Setter Property="BorderBrush" Value="#0F766E" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Complete">
                                                    <Setter Property="Background" Value="#102820" />
                                                    <Setter Property="BorderBrush" Value="#176B51" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Number}" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,3" />
                                        <TextBlock Text="{Binding Detail}" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" MinHeight="30" />
                                        <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold" Margin="0,8,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Current">
                                                            <Setter Property="Foreground" Value="#5EEAD4" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Complete">
                                                            <Setter Property="Foreground" Value="#6EE7B7" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding GuidedDemoMessage}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="SUPPLEMENTARY  VQS INGRESS MONITOR"
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" />
                    <TextBlock Text="{Binding BrowserDropZonePath, Mode=OneWay}"
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,7,0,0" />
                    <TextBlock Text="While VaultSentry is running, the monitor scans files saved here after the download completes. It does not intercept browser downloads or prevent access before scanning, and this folder is not a sandbox. The managed HTTPS intake above is the primary workflow; use only synthetic samples for browser-monitor testing on this device."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="01  REMOTE PAYLOAD FETCH" FontSize="10" Foreground="#7DD3FC" FontWeight="Bold" Margin="0,0,0,12" />
                    <TextBlock Text="DIRECT HTTPS URL" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="HTTPS protects the connection, not the file's safety. VaultSentry writes the response to a temporary intake folder and submits it for static analysis without launching it. Temporary staging is not a VM sandbox."
                               Foreground="#FCD34D" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SourceUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}" />
                        <Button Grid.Column="1" Content="Fetch &amp; Analyze"
                                Command="{Binding DownloadAndScanCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="8"
                                     Foreground="#38BDF8" Background="#26364B"
                                     IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}" />
                        <Button Grid.Column="1" Content="Cancel"
                                Command="{Binding CancelDownloadCommand}"
                                Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,5" Margin="10,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding Phase}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <TextBlock Text="Local diagnostics: analyze a synthetic sample or another selected file."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,18,0,7" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SampleFilePath, Mode=OneWay}"
                                 IsReadOnly="True" Style="{StaticResource InputTextBoxStyle}" />
                        <Button Grid.Column="1" Content="Choose sample"
                                Command="{Binding BrowseCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" />
                        <Button Grid.Column="2" Content="Scan sample"
                                Command="{Binding ScanSampleCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0">
                        <Run Text="Temporary intake folder: " />
                        <Run Text="{Binding QuarantineInboxPath, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                               Foreground="#FDA4AF" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}"
                    Visibility="{Binding HasReport, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="02  ANALYSIS REPORT" Foreground="#7DD3FC" FontSize="10" FontWeight="Bold" Margin="0,0,0,14" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Report.FileName}" Foreground="White" FontSize="17" FontWeight="Bold" />
                            <TextBlock Foreground="#94A3B8" Margin="0,5,0,0">
                                <Run Text="Detected type: " />
                                <Run Text="{Binding Report.Identity.DetectedType, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Foreground="#64748B" FontSize="11" FontFamily="Consolas" Margin="0,3,0,0">
                                <Run Text="SHA256: " />
                                <Run Text="{Binding Report.Hashes.Sha256, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0">
                                <Run Text="Quarantined copy: " />
                                <Run Text="{Binding Report.StagedPath, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{Binding Report.Verdict, Converter={StaticResource SeverityToBrushConverter}}"
                                    CornerRadius="5" Padding="10,6" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Report.Verdict}" Foreground="White" FontWeight="Bold" />
                            </Border>
                            <TextBlock Text="{Binding Report.RiskScore, StringFormat='{}{0}/100'}"
                                       Foreground="White" FontSize="20" FontWeight="Bold" />
                        </StackPanel>
                    </Grid>
                    <Border Background="#10201F" BorderBrush="#1D4843" BorderThickness="1"
                            CornerRadius="7" Padding="15" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="EXECUTIVE SUMMARY" FontSize="10" FontWeight="Bold"
                                       Foreground="#99F6E4" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding HumanAssessment.Summary, Mode=OneWay}"
                                       FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding HumanAssessment.Evidence}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="•" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="12" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding HumanAssessment.Recommendation, Mode=OneWay}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#D1FAE5"
                                       TextWrapping="Wrap" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding HumanAssessment.Limitation, Mode=OneWay}"
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,9,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceInsetBrush}" CornerRadius="7" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="WHAT THE ENGINE CONCLUDED" Foreground="#7DD3FC" FontWeight="Bold" FontSize="10" />
                            <TextBlock Text="{Binding Report.Recommendation}" Foreground="#E2E8F0"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding Findings}" AutoGenerateColumns="False" IsReadOnly="True"
                              Style="{StaticResource DataGridStyle}"
                              MinHeight="90" MaxHeight="260" Background="#0F172A"
                              RowBackground="#0F172A" AlternatingRowBackground="#141C2E"
                              GridLinesVisibility="None" HeadersVisibility="Column"
                              Foreground="White" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="95" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140" />
                            <DataGridTextColumn Header="Finding" Binding="{Binding Finding}" Width="220" />
                            <DataGridTextColumn Header="Why it matters" Binding="{Binding Explanation}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Review the verdict before deciding. Releasing anything other than a SAFE file requires separate warning confirmation."
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,16,0,12" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Delete from Quarantine" Command="{Binding DeleteCommand}"
                                Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="Authorize &amp; Release"
                                    Visibility="{Binding CanStoreReport, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Command="{Binding StoreCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
