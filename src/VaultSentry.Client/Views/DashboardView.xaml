<UserControl x:Class="VaultSentry.Client.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30">
            <!-- Header Title -->
            <TextBlock Text="Security Operations Dashboard" 
                       FontSize="26" 
                       FontWeight="Bold" 
                       Foreground="#FFFFFF" 
                       Margin="0,0,0,25" />

            <!-- KPI Metric Cards Grid -->
            <UniformGrid Columns="3" Margin="0,0,0,30">
                <!-- Total Scans Card -->
                <Border Background="#141C2E" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL SCAN SESSIONS" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding TotalScans}" FontSize="32" FontWeight="Bold" Foreground="#38BDF8" />
                    </StackPanel>
                </Border>

                <!-- Quarantined Threats Card -->
                <Border Background="#141C2E" CornerRadius="8" Padding="20" Margin="5,0,5,0">
                    <StackPanel>
                        <TextBlock Text="QUARANTINED THREATS" FontSize="11" FontWeight="Bold" Foreground="#EF4444" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding QuarantinedThreats}" FontSize="32" FontWeight="Bold" Foreground="#EF4444" />
                    </StackPanel>
                </Border>

                <!-- Clean Files Card -->
                <Border Background="#141C2E" CornerRadius="8" Padding="20" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="VERIFIED CLEAN FILES" FontSize="11" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding CleanFiles}" FontSize="32" FontWeight="Bold" Foreground="#10B981" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- System Status & Quick Actions Card -->
            <Border Background="#141C2E" CornerRadius="8" Padding="25">
                <StackPanel>
                    <TextBlock Text="VQS Ingress Protection Status" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,10" />
                    <TextBlock Text="Active. Real-time file system monitoring is intercepting incoming downloads via the Virtual Quarantine Space dropzone." 
                               FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,20" />
                    
                    <Button Content="Refresh Telemetry Metrics" 
                            Command="{Binding LoadMetricsCommand}" 
                            Background="#334155" 
                            Foreground="#FFFFFF" 
                            FontWeight="SemiBold" 
                            Width="200" 
                            Height="35" 
                            HorizontalAlignment="Left"
                            BorderThickness="0" 
                            Cursor="Hand" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>