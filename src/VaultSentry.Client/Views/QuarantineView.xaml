<UserControl x:Class="VaultSentry.Client.Views.QuarantineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="900">
    <Grid Margin="34,30,34,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Title & Refresh -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Quarantine vault" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Review static analysis results and manage files staged in quarantine storage."
                           Style="{StaticResource PageSubtitleStyle}" Margin="0,5,0,0" />
            </StackPanel>
            <Button Grid.Column="1" 
                    Content="Refresh Vault" 
                    Command="{Binding LoadItemsCommand}" 
                    Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Releasing a suspicious or malicious file requires explicit confirmation. Review the verdict before release."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Padding="4,4,4,10"
                       FontSize="12" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisConverter}}"
                       Background="#27151D"
                       Foreground="#FDA4AF"
                       Padding="12"
                       TextWrapping="Wrap" />
            <TextBlock Text="No scans have been saved to the vault yet. Scan a file to add an entry."
                       Visibility="{Binding HasItems, Converter={StaticResource BoolToInverseVisConverter}}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Padding="12,10"
                       Background="{StaticResource SurfaceBrush}" />
            <TextBlock Text="Loading quarantine records..."
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"
                       Foreground="#7DD3FC"
                       Padding="12,10" />
        </StackPanel>

        <!-- Ledger DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10">
            <DataGrid ItemsSource="{Binding QuarantinedItems}" 
                      Style="{StaticResource DataGridStyle}"
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      Background="Transparent" 
                      RowBackground="#0F172A" 
                      AlternatingRowBackground="#141C2E" 
                      GridLinesVisibility="None" 
                      HeadersVisibility="Column" 
                      BorderThickness="0" 
                      Foreground="#FFFFFF" 
                      FontSize="12">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1E293B" />
                        <Setter Property="Foreground" Value="#94A3B8" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Quarantine ID" Binding="{Binding QuarantineId}" Width="160" FontFamily="Consolas" FontSize="11" />
                    <DataGridTextColumn Header="Original Path" Binding="{Binding OriginalPath}" Width="*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" FontWeight="Bold" />
                    <DataGridTextColumn Header="Verdict" Binding="{Binding Verdict}" Width="110" FontWeight="Bold" />
                    <DataGridTextColumn Header="Timestamp" Binding="{Binding CreatedAt}" Width="140" />
                    
                    <!-- Action Buttons Column -->
                    <DataGridTemplateColumn Header="Operations" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Authorize &amp; Release"
                                            Command="{Binding DataContext.ReleaseFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="9,5" Margin="0,0,8,0" />
                                    
                                    <Button Content="Delete"
                                            Command="{Binding DataContext.ShredFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Padding="9,5" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>