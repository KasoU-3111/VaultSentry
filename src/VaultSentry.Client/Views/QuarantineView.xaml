<UserControl x:Class="VaultSentry.Client.Views.QuarantineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="900">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Title & Refresh -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Quarantine Vault Ledger" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
            <Button Grid.Column="1" 
                    Content="Refresh Vault" 
                    Command="{Binding LoadItemsCommand}" 
                    Background="#334155" 
                    Foreground="#FFFFFF" 
                    FontWeight="SemiBold" 
                    Padding="15,8" 
                    BorderThickness="0" 
                    Cursor="Hand" />
        </Grid>

        <!-- Ledger DataGrid -->
        <Border Grid.Row="1" Background="#141C2E" CornerRadius="8" Padding="15">
            <DataGrid ItemsSource="{Binding QuarantinedItems}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      Background="Transparent" 
                      RowBackground="#0F172A" 
                      AlternatingRowBackground="#141C2E" 
                      GridLinesVisibility="None" 
                      HeadersVisibility="Column" 
                      BorderThickness="0" 
                      Foreground="#FFFFFF" 
                      FontSize="12">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1E293B" />
                        <Setter Property="Foreground" Value="#94A3B8" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Quarantine ID" Binding="{Binding QuarantineId}" Width="160" FontFamily="Consolas" FontSize="11" />
                    <DataGridTextColumn Header="Original Path" Binding="{Binding OriginalPath}" Width="*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" FontWeight="Bold" />
                    <DataGridTextColumn Header="Timestamp" Binding="{Binding CreatedAt}" Width="140" />
                    
                    <!-- Action Buttons Column -->
                    <DataGridTemplateColumn Header="Operations" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Release" 
                                            Command="{Binding DataContext.ReleaseFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}"
                                            Background="#0284C7" Foreground="White" FontWeight="SemiBold" 
                                            Padding="10,4" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" />
                                    
                                    <Button Content="Shred" 
                                            Command="{Binding DataContext.ShredFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}"
                                            Background="#DC2626" Foreground="White" FontWeight="SemiBold" 
                                            Padding="10,4" BorderThickness="0" Cursor="Hand" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>