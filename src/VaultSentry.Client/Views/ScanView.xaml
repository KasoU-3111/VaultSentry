<UserControl x:Class="VaultSentry.Client.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30">
            <!-- Header Title -->
            <TextBlock Text="Static Security Scanner" 
                       FontSize="26" 
                       FontWeight="Bold" 
                       Foreground="#FFFFFF" 
                       Margin="0,0,0,25" />

            <!-- Input & Execution Card -->
            <Border Background="#141C2E" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Target File Path:" 
                               Foreground="#94A3B8" 
                               FontSize="13" 
                               Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" 
                                 Text="{Binding TargetFilePath, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="#0F172A" 
                                 Foreground="#FFFFFF" 
                                 BorderBrush="#334155" 
                                 Padding="10,8" 
                                 FontSize="13" />

                        <Button Grid.Column="1" 
                                Content="Browse..." 
                                Command="{Binding BrowseCommand}" 
                                Background="#334155" 
                                Foreground="#FFFFFF" 
                                FontWeight="SemiBold" 
                                Padding="15,8" 
                                Margin="10,0,0,0" 
                                BorderThickness="0" 
                                Cursor="Hand" />

                        <Button Grid.Column="2" 
                                Content="Run Scan" 
                                Command="{Binding RunScanCommand}" 
                                Background="#0284C7" 
                                Foreground="#FFFFFF" 
                                FontWeight="Bold" 
                                Padding="20,8" 
                                Margin="10,0,0,0" 
                                BorderThickness="0" 
                                Cursor="Hand" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Error Banner -->
            <Border Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,20"
                    Visibility="{Binding AnalysisViewModel.ErrorMessage, Converter={StaticResource StringToVisConverter}}">
                <TextBlock Text="{Binding AnalysisViewModel.ErrorMessage}" Foreground="#FCA5A5" TextWrapping="Wrap" FontSize="13" />
            </Border>

            <!-- Loading Indicator -->
            <Border Background="#141C2E" CornerRadius="8" Padding="20" Margin="0,0,0,20"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="[+] Executing Isolated Static Analysis in VQS Container..." 
                           Foreground="#38BDF8" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" />
            </Border>

            <!-- Scan Assessment Report Card -->
            <StackPanel>
                <Border Background="#141C2E" CornerRadius="8" Padding="25" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header Metadata -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding TargetFilePath}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding AnalysisViewModel.IdentifiedType, StringFormat='Identified Type: {0}'}" 
                                           FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding AnalysisViewModel.Sha256Hash, StringFormat='SHA256: {0}'}" 
                                           FontSize="11" Foreground="#64748B" Margin="0,2,0,0" FontFamily="Consolas" />
                            </StackPanel>

                            <!-- Verdict Badge & Risk Score -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                                <Border Background="{Binding AnalysisViewModel.Verdict, Converter={StaticResource SeverityToBrushConverter}}" 
                                        CornerRadius="6" Padding="12,6" Margin="0,0,15,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AnalysisViewModel.Verdict}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Risk Score" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding AnalysisViewModel.RiskScore, StringFormat='{}{0} / 100'}" 
                                               FontSize="20" FontWeight="Bold" 
                                               Foreground="{Binding AnalysisViewModel.Verdict, Converter={StaticResource SeverityToBrushConverter}}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Recommendation Block -->
                        <Border Grid.Row="1" Background="#0F172A" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="SECURITY RECOMMENDATION" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding AnalysisViewModel.SecurityRecommendation}" FontSize="13" Foreground="#E2E8F0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- RESTORED: Quarantine Decision Action Controls -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Shred &amp; Destroy Payload" 
                                    Command="{Binding ShredPayloadCommand}"
                                    Background="#DC2626" 
                                    Foreground="#FFFFFF" 
                                    FontWeight="Bold" 
                                    Padding="15,8" 
                                    BorderThickness="0" 
                                    Cursor="Hand" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Granular Explainability Findings Table -->
                <TextBlock Text="Explainable Security Findings" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,10,0,12" />
                <Border Background="#141C2E" CornerRadius="8" Padding="15">
                    <DataGrid ItemsSource="{Binding AnalysisViewModel.Findings}" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              Background="Transparent" 
                              RowBackground="#0F172A" 
                              AlternatingRowBackground="#141C2E" 
                              GridLinesVisibility="None" 
                              HeadersVisibility="Column" 
                              BorderThickness="0" 
                              Foreground="#FFFFFF" 
                              FontSize="12">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Padding" Value="5" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Severity" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}" 
                                                CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="5">
                                            <TextBlock Text="{Binding Severity}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Finding" Binding="{Binding Finding}" Width="220" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Explanation" Binding="{Binding Explanation}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>