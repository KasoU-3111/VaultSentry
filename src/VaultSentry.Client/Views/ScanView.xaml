<UserControl x:Class="VaultSentry.Client.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,30,34,36">
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="File analysis" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Inspect file identity and format-specific risk signals with VaultSentry's local static analysis pipeline."
                           Style="{StaticResource PageSubtitleStyle}" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Input & Execution Card -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="SELECT A FILE" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,9" />
                    <TextBlock Text="Applicable checks may include file identity and hashes, PE, document and macro, installer, archive, disk-image, shortcut and script analysis, YARA signatures, available ClamAV signatures, and heuristic rules. Checks depend on file type and configured or available components."
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding TargetFilePath, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Target file path"
                                 Style="{StaticResource InputTextBoxStyle}" />

                        <Button Grid.Column="1" 
                                Content="Browse..." 
                                Command="{Binding BrowseCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="10,0,0,0" />

                        <Button Grid.Column="2" 
                                Content="Run Scan" 
                                Command="{Binding RunScanCommand}" 
                                AutomationProperties.Name="Run Scan"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="10,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Error Banner -->
            <Border Background="#27151D" BorderBrush="#7F3342" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,18"
                    Visibility="{Binding AnalysisViewModel.ErrorMessage, Converter={StaticResource StringToVisConverter}}">
                <TextBlock Text="{Binding AnalysisViewModel.ErrorMessage}" Foreground="#FCA5A5" TextWrapping="Wrap" FontSize="13" />
            </Border>

            <!-- Loading Indicator -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="[+] Running VaultSentry local static analysis..."
                           Foreground="#38BDF8" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" />
            </Border>

            <!-- Scan Assessment Report Card -->
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,0,0,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header Metadata -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding TargetFilePath}"                                 FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding AnalysisViewModel.IdentifiedType, StringFormat='Identified Type: {0}'}" 
                                           FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding AnalysisViewModel.Sha256Hash, StringFormat='SHA256: {0}'}" 
                                           FontSize="11" Foreground="#64748B" Margin="0,2,0,0" FontFamily="Consolas" />
                            </StackPanel>

                            <!-- Verdict Badge & Risk Score -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                                <Border Background="{Binding AnalysisViewModel.Verdict, Converter={StaticResource SeverityToBrushConverter}}" 
                                        CornerRadius="6" Padding="12,6" Margin="0,0,15,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AnalysisViewModel.Verdict}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Risk Score" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding AnalysisViewModel.RiskScore, StringFormat='{}{0} / 100'}" 
                                               FontSize="20" FontWeight="Bold" 
                                               Foreground="{Binding AnalysisViewModel.Verdict, Converter={StaticResource SeverityToBrushConverter}}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Recommendation Block -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceInsetBrush}" CornerRadius="7" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="SECURITY RECOMMENDATION" FontSize="10" FontWeight="Bold" Foreground="#7DD3FC" Margin="0,0,0,5" />
                                <TextBlock Text="{Binding AnalysisViewModel.SecurityRecommendation}" FontSize="13" Foreground="#E2E8F0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Background="#10201F" BorderBrush="#1D4843"
                                BorderThickness="1" CornerRadius="7" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="EXECUTIVE SUMMARY" FontSize="10" FontWeight="Bold"
                                           Foreground="#99F6E4" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding AnalysisViewModel.HumanAssessment.Summary, Mode=OneWay}"
                                           FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding AnalysisViewModel.HumanAssessment.Evidence}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,7,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="•" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                                                <TextBlock Grid.Column="1" Text="{Binding}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="12" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding AnalysisViewModel.HumanAssessment.Recommendation, Mode=OneWay}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#D1FAE5"
                                           TextWrapping="Wrap" Margin="0,10,0,0" />
                                <TextBlock Text="{Binding AnalysisViewModel.HumanAssessment.Limitation, Mode=OneWay}"
                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap" Margin="0,9,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Quarantine Decision Action Controls -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Delete quarantined file"
                                    Command="{Binding ShredPayloadCommand}"
                                    Style="{StaticResource DangerButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Granular Explainability Findings Table -->
                <TextBlock Text="Explainable security findings" Style="{StaticResource SectionHeadingStyle}" Margin="0,8,0,12" />
                <Border Style="{StaticResource CardStyle}" Padding="10">
                    <DataGrid ItemsSource="{Binding AnalysisViewModel.Findings}" 
                              Style="{StaticResource DataGridStyle}"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              Background="Transparent" 
                              RowBackground="#0F172A" 
                              AlternatingRowBackground="#141C2E" 
                              GridLinesVisibility="None" 
                              HeadersVisibility="Column" 
                              BorderThickness="0" 
                              Foreground="#FFFFFF" 
                              FontSize="12">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Padding" Value="5" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Severity" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}" 
                                                CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="5">
                                            <TextBlock Text="{Binding Severity}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Finding" Binding="{Binding Finding}" Width="220" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Explanation" Binding="{Binding Explanation}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>