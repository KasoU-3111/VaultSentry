<Window x:Class="VaultSentry.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:VaultSentry.Client.Views"
        xmlns:vm="clr-namespace:VaultSentry.Client.ViewModels"
        mc:Ignorable="d"
        Title="VaultSentry | Security Operations"
        Height="850" Width="1400" MinHeight="700" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        FontFamily="Segoe UI"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanViewModel}">
            <views:ScanView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuarantineViewModel}">
            <views:QuarantineView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DownloadSimulationViewModel}">
            <views:DownloadSimulationView />
        </DataTemplate>

        <Style x:Key="NavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,11" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavigationBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NavigationIndicator" Background="{StaticResource AccentBrush}"
                                        CornerRadius="2" Margin="0,7,0,7" Opacity="0" />
                                <ContentPresenter Grid.Column="1"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationBackground" Property="BorderBrush" Value="#26485A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavigationBackground" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding CurrentSection}" Value="Overview" />
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="Overview" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="NavigationIndicator" Property="Opacity" Value="1" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding CurrentSection}" Value="File analysis" />
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="File analysis" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="NavigationIndicator" Property="Opacity" Value="1" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding CurrentSection}" Value="Quarantine vault" />
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="Quarantine vault" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="NavigationIndicator" Property="Opacity" Value="1" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding CurrentSection}" Value="VQS URL ingestion" />
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="VQS URL ingestion" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="NavigationIndicator" Property="Opacity" Value="1" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DashboardNavigationStyle" TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentSection}" Value="Overview">
                    <Setter Property="Background" Value="#14263A" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="#1D4B67" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AnalysisNavigationStyle" TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentSection}" Value="File analysis">
                    <Setter Property="Background" Value="#14263A" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="#1D4B67" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VaultNavigationStyle" TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentSection}" Value="Quarantine vault">
                    <Setter Property="Background" Value="#14263A" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="#1D4B67" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DownloadNavigationStyle" TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentSection}" Value="VQS URL ingestion">
                    <Setter Property="Background" Value="#14263A" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="#1D4B67" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18,22,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0,0,34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="9" Background="#0C4A6E"
                            BorderBrush="#155E75" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="V" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="VAULTSENTRY" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="SECURITY RESEARCH" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="1,3,0,0" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="THE WORKFLOW" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,10" />
                    <Button Style="{StaticResource DashboardNavigationStyle}"
                            Command="{Binding NavigateToDashboardCommand}"
                            Tag="Overview"
                            AutomationProperties.Name="Overview">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="01" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Overview" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource AnalysisNavigationStyle}"
                            Command="{Binding NavigateToScanCommand}"
                            Tag="File analysis"
                            AutomationProperties.Name="File analysis">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="02" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Analyze a file" VerticalAlignment="Center" />
                                <TextBlock Text="Evidence &amp; verdict" FontSize="9"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource VaultNavigationStyle}"
                            Command="{Binding NavigateToQuarantineCommand}"
                            Tag="Quarantine vault"
                            AutomationProperties.Name="Quarantine vault">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="03" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Quarantine vault" VerticalAlignment="Center" />
                                <TextBlock Text="Held files &amp; decisions" FontSize="9"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource DownloadNavigationStyle}"
                            Command="{Binding NavigateToDownloadSimulationCommand}"
                            Tag="VQS URL ingestion"
                            AutomationProperties.Name="VQS URL ingestion">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="04" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="VQS URL ingestion" VerticalAlignment="Center" />
                                <TextBlock Text="HTTPS intake &amp; diagnostics" FontSize="9"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>

                <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Ellipse Width="7" Height="7" Fill="#34D399" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="LOCAL ANALYSIS MODE" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="An added review layer—not a replacement for existing protection."
                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0B1321" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="28,0">
                <Grid>
                    <TextBlock Text="{Binding CurrentSection}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="12"
                            Background="#13263A" BorderBrush="#1E3A52" BorderThickness="1"
                            Padding="10,5">
                        <TextBlock Text="RESEARCH DEMONSTRATION" FontSize="9" FontWeight="Bold"
                                   Foreground="#7DD3FC" />
                    </Border>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
        </Grid>
    </Grid>
</Window>
