<Window x:Class="VaultSentry.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:VaultSentry.Client.Views"
        xmlns:vm="clr-namespace:VaultSentry.Client.ViewModels"
        mc:Ignorable="d"
        Title="VaultSentry - Secure Download Quarantine Platform" 
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120">

    <Window.Resources>
        <!-- Polymorphic View Resolution for ViewModels using the correct 'views:' prefix -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanViewModel}">
            <views:ScanView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuarantineViewModel}">
            <views:QuarantineView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <StackPanel Margin="20">
                <!-- Platform Branding -->
                <TextBlock Text="VAULTSENTRY" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="#38BDF8" 
                           Margin="0,10,0,30" />

                <!-- Navigation Buttons -->
                <Button Content="Dashboard" 
                        Command="{Binding NavigateToDashboardCommand}" 
                        Background="#1E293B" 
                        Foreground="#FFFFFF" 
                        FontWeight="SemiBold" 
                        Padding="15,12" 
                        Margin="0,0,0,10" 
                        BorderThickness="0" 
                        Cursor="Hand" />

                <Button Content="File Analysis" 
                        Command="{Binding NavigateToScanCommand}" 
                        Background="#1E293B" 
                        Foreground="#FFFFFF" 
                        FontWeight="SemiBold" 
                        Padding="15,12" 
                        Margin="0,0,0,10" 
                        BorderThickness="0" 
                        Cursor="Hand" />

                <Button Content="Quarantine Vault" 
                        Command="{Binding NavigateToQuarantineCommand}" 
                        Background="#1E293B" 
                        Foreground="#FFFFFF" 
                        FontWeight="SemiBold" 
                        Padding="15,12" 
                        Margin="0,0,0,10" 
                        BorderThickness="0" 
                        Cursor="Hand" />
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>