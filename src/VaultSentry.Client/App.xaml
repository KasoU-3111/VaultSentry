<Application x:Class="VaultSentry.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VaultSentry.Client.Converters">
    <Application.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <converters:BooleanToInverseVisibilityConverter x:Key="BoolToInverseVisConverter" />
        <converters:SeverityToBrushConverter x:Key="SeverityToBrushConverter" />
    </Application.Resources>
</Application>